{
  "appId": "com.proutility.app",
  "appName": "ProUtility",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.imgly.com",
      "*.jsdelivr.net",
      "*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": false,
      "backgroundColor": "#0f172a",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#3b82f6"
    }
  }
}